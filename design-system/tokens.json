      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.375rem", "$type": "dimension" },
      "2xl": { "$value": "1.75rem", "$type": "dimension" },
      "3xl": { "$value": "clamp(2rem, 4vw, 3rem)", "$type": "dimension" },
      "4xl": { "$value": "clamp(2.5rem, 6vw, 4.5rem)", "$type": "dimension" },
      "5xl": { "$value": "clamp(2.75rem, 8vw, 6.5rem)", "$type": "dimension" }
    },
    "spacing": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
