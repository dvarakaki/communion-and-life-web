      "slow": { "$value": "600ms", "$type": "duration" }
    },
    "easing": {
      "out": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.ink.50}", "$type": "color" },
      "surface": { "$value": "{primitive.color.white}", "$type": "color" },
      "surface-alt": { "$value": "{primitive.color.ink.100}", "$type": "color" },
      "foreground": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "muted": { "$value": "{primitive.color.ink.500}", "$type": "color" },
      "border": { "$value": "{primitive.color.ink.200}", "$type": "color" },
      "inverse-bg": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "inverse-surface": { "$value": "{primitive.color.ink.800}", "$type": "color" },
      "inverse-fg": { "$value": "{primitive.color.ink.50}", "$type": "color" },
      "inverse-muted": { "$value": "{primitive.color.ink.400}", "$type": "color" },
      "primary": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "on-primary": { "$value": "{primitive.color.white}", "$type": "color" },
      "accent": { "$value": "{primitive.color.fire.600}", "$type": "color" },
      "accent-bright": { "$value": "{primitive.color.fire.500}", "$type": "color" },
      "accent-soft": { "$value": "{primitive.color.fire.300}", "$type": "color" },
      "glow": { "$value": "{primitive.color.amber.400}", "$type": "color" },
      "ring": { "$value": "{primitive.color.fire.500}", "$type": "color" }
