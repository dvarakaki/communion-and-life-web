    "font": {
      "heading": { "$value": "{primitive.font.display}", "$type": "fontFamily" },
      "accent": { "$value": "{primitive.font.serif}", "$type": "fontFamily" },
      "body": { "$value": "{primitive.font.body}", "$type": "fontFamily" }
    }
