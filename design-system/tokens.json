  "component": {
    "button": {
      "primary-bg": { "$value": "{semantic.color.accent}", "$type": "color" },
      "primary-fg": { "$value": "{primitive.color.white}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.fire.700}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" },
      "height": { "$value": "3rem", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "shadow": { "$value": "{primitive.shadow.md}", "$type": "shadow" }
    },
    "nav": {
      "height": { "$value": "4.5rem", "$type": "dimension" }
    }
  }
