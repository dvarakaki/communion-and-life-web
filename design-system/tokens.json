      "xl": { "$value": "36px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 2px rgb(10 9 8 / 0.06)", "$type": "shadow" },
      "md": { "$value": "0 8px 24px -8px rgb(10 9 8 / 0.18)", "$type": "shadow" },
      "lg": { "$value": "0 24px 60px -20px rgb(10 9 8 / 0.35)", "$type": "shadow" },
      "glow": { "$value": "0 0 0 1px rgb(242 107 29 / 0.25), 0 20px 60px -15px rgb(242 107 29 / 0.55)", "$type": "shadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
